{
  "buildCommand": null,
  "outputDirectory": ".",
  "framework": null,
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/",
      "destination": "/examples/landing-page"
    },
    {
      "source": "/showcase",
      "destination": "/examples/showcase"
    },
    {
      "source": "/showcase/",
      "destination": "/examples/showcase"
    },
    {
      "source": "/themes",
      "destination": "/examples/theme-showcase"
    },
    {
      "source": "/quick-start",
      "destination": "/examples/quick-start"
    },
    {
      "source": "/components/:path*",
      "destination": "/examples/components/:path*"
    }
  ],
  "headers": [
    {
      "source": "/skills/han-design/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/skills/han-design/assets/(.*)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/css; charset=utf-8"
        }
      ]
    }
  ]
}
