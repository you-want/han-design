{
  "buildCommand": null,
  "outputDirectory": ".",
  "framework": null,
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/",
      "destination": "/examples/landing-page.html"
    },
    {
      "source": "/showcase",
      "destination": "/examples/theme-showcase.html"
    },
    {
      "source": "/showcase/",
      "destination": "/examples/theme-showcase.html"
    },
    {
      "source": "/quick-start",
      "destination": "/examples/quick-start.html"
    },
    {
      "source": "/components/:path*",
      "destination": "/examples/components/:path*"
    }
  ],
  "headers": [
    {
      "source": "/skill/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/skill/assets/(.*)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/css; charset=utf-8"
        }
      ]
    }
  ]
}
