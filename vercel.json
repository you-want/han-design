{
  "buildCommand": null,
  "outputDirectory": ".",
  "framework": null,
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/",
      "destination": "/examples/landing-page.html"
    },
    {
      "source": "/showcase",
      "destination": "/examples/theme-showcase.html"
    },
    {
      "source": "/showcase/",
      "destination": "/examples/theme-showcase.html"
    },
    {
      "source": "/quick-start",
      "destination": "/examples/quick-start.html"
    },
    {
      "source": "/components/:path*",
      "destination": "/components/:path*"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/css/(.*)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/css; charset=utf-8"
        }
      ]
    },
    {
      "source": "/assets/icons/(.*)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "image/svg+xml"
        }
      ]
    }
  ]
}
